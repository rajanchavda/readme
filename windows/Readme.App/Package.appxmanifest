<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package (built with -p:ReadmePackage=true; see windows/README.md). Identity Name and
  Publisher are placeholders until the app is reserved in Partner Center: the Store gives both, and
  they go here before the first upload. The Store signs the package, so nothing here is secret.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="Readme.Reader" Publisher="CN=Readme Development" Version="1.5.7.0" />

  <Properties>
    <DisplayName>Readme</DisplayName>
    <PublisherDisplayName>Rajan Chavda</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 11 only, as decided. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Readme"
        Description="A quiet EPUB reader that turns pages like a book."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#2A231D" />
      </uap:VisualElements>
      <Extensions>
        <!-- Double-clicking a book, or Open with > Readme. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="epub">
            <uap:DisplayName>EPUB book</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/epub+zip">.epub</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- A library exported from Readme on a Mac or a PC. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="readmelibrary">
            <uap:DisplayName>Readme library</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.readmelibrary</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop app: it reads books wherever they are and keeps its library in Documents\Readme. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
