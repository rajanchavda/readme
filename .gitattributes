# Keep text files LF in the repo and in every working tree, so the Mac and
# Windows builds share Readme/Web/ and the test fixtures byte for byte.
* text=auto eol=lf

# Windows scripts need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never convert, never diff as text.
*.epub binary
*.readmelibrary binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pfx binary
*.snk binary
